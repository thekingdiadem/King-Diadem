# ข้อมูลตอนรัน (ค่าเริ่มต้นของ core/paths.py เมื่อไม่ได้ตั้ง DB_PATH) — ไม่ใช่ซอร์สโค้ด
data/
*.db
# bytecode
__pycache__/
*.pyc

# ไฟล์ส่วนตัวที่ไม่ขึ้น repo สาธารณะ (เช่นรูปโปรไฟล์ผู้สร้าง — ส่งผ่าน KD_PROFILE_IMAGE)
private/

# กุญแจและรหัสลับ — ห้ามขึ้น repo เด็ดขาด (ตั้งใน Render → Environment แทน)
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# ผลวัด coverage (python -m coverage run ...) — สร้างใหม่ได้ทุกครั้ง
.coverage
.coverage.*
htmlcov/
